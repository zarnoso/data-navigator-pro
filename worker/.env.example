# Puerto HTTP del worker (DonWeb debe permitirlo o proxy con nginx a 443)
PORT=8787

# Supabase (usar SERVICE ROLE, NO exponer al cliente)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Secreto compartido con las Edge Functions para validar HMAC del /trigger
MAPADATA_WORKER_SECRET=cambiar_por_el_mismo_valor_que_supabase

# Google Places API (New) key con Places API habilitada
GOOGLE_PLACES_API_KEY=AIza...

# Máximo de runs procesándose en paralelo
WORKER_MAX_CONCURRENCY=2

# Intervalo (ms) del cron que recoge runs 'pending' huérfanos
WORKER_CRON_INTERVAL_MS=60000

# Nombre del bucket de exports en Supabase Storage
MAPADATA_EXPORTS_BUCKET=mapadata-exports
